<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" styleClass="dialog-pane" stylesheets="/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.swe.chat.CreatePollController">
    <Label text="Create a New Poll" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <TextField fx:id="questionField" promptText="Enter your poll question"/>
    <Label text="Options:"/>
    <VBox fx:id="optionsContainer" spacing="5"/>
    <Button text="Add Option" onAction="#addOptionField"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#cancel"/>
        <Button text="Create Poll" onAction="#createPoll" styleClass="send-button"/>
    </HBox>
</VBox>